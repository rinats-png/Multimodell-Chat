# Kopie als .env.local anlegen. Werte NIE committen (.env* steht in .gitignore).
# Vollständige Schlüsselliste mit Einstufung: docs/idea-to-app/14-sicherheit.md → „Schlüssel“.

# --- App -------------------------------------------------------------------
# Öffentliche Adresse (für Origin-Prüfung, Checkout- und E-Mail-Links), z. B. https://app.example.com
APP_ORIGIN=
# Nur für eine öffentliche Vorschau ohne Supabase: Demo-Workspace mit simuliertem Modell erlauben.
ALLOW_DEMO_MODE=

# --- KI (geheim) -----------------------------------------------------------
# Ohne Key (und ohne BYOK) läuft die App mit simulierten Antworten.
OPENROUTER_API_KEY=
ROUTER_MODEL=google/gemini-2.5-flash
SUMMARY_MODEL=openai/gpt-4o-mini
# "deny" (Standard): nur Anbieter ohne Datenspeicherung/Training. "allow" nur nach Datenschutz-Prüfung.
OPENROUTER_DATA_COLLECTION=deny
# 32 Byte, base64 – verschlüsselt eigene OpenRouter-Keys der Nutzer: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=

# --- Supabase ----------------------------------------------------------------
# Öffentlich (nur mit aktiver RLS, siehe supabase/migrations):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM – umgeht RLS, nur serverseitig:
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate-Limiting (in Produktion Pflicht) ---------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (geheim) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# --- Betreiber (Impressum / Datenschutz, in Produktion Pflicht) -------------
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_REPRESENTATIVE=
OPERATOR_VAT_ID=
