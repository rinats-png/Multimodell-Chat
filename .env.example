# --- KI-Provider (OpenRouter) -------------------------------------------
# Ohne Key (und ohne BYOK-Key im Profil) läuft die App im Demo-Modus mit
# simulierten Antworten.
OPENROUTER_API_KEY=
# Modell für Moderator-Router und Langzeit-Zusammenfassung
ROUTER_MODEL=google/gemini-2.5-flash
SUMMARY_MODEL=openai/gpt-4o-mini

# --- Supabase ------------------------------------------------------------
# Ohne diese Variablen nutzt die App einen In-Memory-Store mit Demo-User.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Rate-Limiting (optional, sonst In-Memory Sliding Window) -------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Billing (z. B. Stripe Payment Links) ----------------------------------
NEXT_PUBLIC_CHECKOUT_URL_PRO=
NEXT_PUBLIC_CHECKOUT_URL_TEAM=
